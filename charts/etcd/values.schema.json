{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "ETCD chart values",
  "type": "object",
  "properties": {
    "nameOverride": {
      "description": "Override the chart name",
      "type": "string"
    },
    "fullnameOverride": {
      "description": "Override the fully qualified application name",
      "type": "string"
    },
    "replicaCount": {
      "description": "Number of etcd replicas",
      "type": "integer",
      "minimum": 1
    },
    "clusterDomain": {
      "description": "Cluster domain suffix, used to build DNS SANs for TLS certificates",
      "type": "string",
      "minLength": 1
    },
    "image": {
      "description": "Container image configuration",
      "type": "object",
      "properties": {
        "registry": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "Never",
            "IfNotPresent"
          ]
        }
      },
      "required": [
        "registry",
        "repository",
        "pullPolicy"
      ]
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name"
        ]
      }
    },
    "initialClusterState": {
      "description": "Initial etcd cluster state",
      "type": "string",
      "enum": [
        "new",
        "existing"
      ]
    },
    "persistence": {
      "type": "object",
      "properties": {
        "size": {
          "description": "Persistent volume size",
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "size"
      ]
    },
    "podAnnotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "podLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "resources": {
      "type": "object"
    },
    "readinessProbe": {
      "type": "object",
      "properties": {
        "initialDelaySeconds": {
          "type": "integer",
          "minimum": 0
        },
        "periodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "successThreshold": {
          "type": "integer",
          "minimum": 1
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "livenessProbe": {
      "type": "object",
      "properties": {
        "initialDelaySeconds": {
          "type": "integer",
          "minimum": 0
        },
        "periodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "volumes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "volumeMounts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "affinity": {
      "type": "object"
    },
    "pdb": {
      "description": "Pod Disruption Budget configuration",
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "maxUnavailable": {
          "type": ["integer", "string"]
        },
        "minAvailable": {
          "type": ["integer", "string"]
        }
      }
    },
    "tls": {
      "description": "mTLS configuration for etcd client and peer communication",
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "certManager": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "issuerRef": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "kind": {
                  "type": "string",
                  "enum": ["Issuer", "ClusterIssuer"]
                },
                "group": {
                  "type": "string"
                }
              }
            },
            "duration": {
              "type": "string"
            },
            "renewBefore": {
              "type": "string"
            }
          }
        },
        "client": {
          "type": "object",
          "properties": {
            "existingSecret": {
              "type": "string"
            }
          }
        },
        "peer": {
          "type": "object",
          "properties": {
            "existingSecret": {
              "type": "string"
            }
          }
        }
      },
      "required": ["enabled", "certManager", "client", "peer"]
    }
  },
  "required": [
    "replicaCount",
    "image",
    "initialClusterState",
    "persistence"
  ]
}